local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")

--// Remote Events //--
local BuyItemEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BuyItem") -- Replace "Remotes" with the actual folder name if different

--// Functions //--

-- Function to buy a gamepass or fruit (handles errors gracefully)
local function BuyItem(itemName, itemType)
    --// Checks //--
    if not itemName or not itemType then
        print("Error: Item name and item type are required.")
        return
    end

    if not BuyItemEvent then
        print("Error: BuyItemEvent not found in ReplicatedStorage. Check your explorer.")
        return
    end

    --// Attempt to buy the item //--
    pcall(function()
        BuyItemEvent:FireServer(itemName, itemType)
        print("Attempting to buy " .. itemName .. " (" .. itemType .. ")")
    end)
end

