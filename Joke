--// Optional: Command-line interface //--
local function ExecuteCommand(command)
	local args = string.split(command, " ")
	local cmd = args[1]
	table.remove(args, 1)

	if cmd == "buygamepasses" then
		BuyAllGamepasses()
	elseif cmd == "buyfruits" then
		BuyAllFruits()
	elseif cmd == "buy" then -- Example: buy Dough fruit
		if #args < 2 then
			print("Usage: buy <item_name> <item_type (fruit/gamepass)>")
			return
		end
		local itemName = args[1]
		local itemType = args[2]
		BuyItem(itemName, itemType)
	else
		print("Unknown command.")
	end
end

